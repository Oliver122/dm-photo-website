# Copy to deploy/app/.env and fill in. Never commit .env.

# --- registry pull (used by compose interpolation; also export in shell) ---
ARTIFACTORY_DOCKER_REGISTRY=dm-registry.olivers-homelab2.cc
TAG=latest

# --- app ---
ADMIN_PASSWORD=
SESSION_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your.host/auth/discord/callback
DISCORD_BOT_TOKEN=
DM_MESSAGE=

# --- PhotoPrism ingest (REQ-005; optional until feature ships) ---
PHOTOPRISM_BASE_URL=https://photos.example.com
PHOTOPRISM_APP_PASSWORD=
PHOTOPRISM_USER_UID=
PHOTOPRISM_DEFAULT_ALBUM=
# PHOTOPRISM_VERIFY_TLS=true
