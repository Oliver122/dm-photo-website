# Copy to .env in this same folder, then: docker compose up -d
# Do not commit .env.

# --- image ---
# Host only — no https://
DOCKER_IMAGE=dm-registry.olivers-homelab2.cc/dm-photo-website:latest
HOST_PORT=8080

# --- app (relative paths inside the container cwd /app) ---
SERVER_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://data/app.db
ANALOG_INGEST_DIR=data/ingest

# Change before production — Compose defaults to changeme if unset.
ADMIN_PASSWORD=changeme
# openssl rand -base64 64
SESSION_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your.host/auth/discord/callback
DISCORD_BOT_TOKEN=
DM_MESSAGE=

# dm Foto key account id (spot.photoprintit.com), default 1320
DM_KEY_ACCOUNT_ID=1320

# Discord allowlist — snowflake IDs and/or Discord usernames (handles). Comma or whitespace separated.
# Username is easiest (your Discord handle, not display name). Optional: numeric snowflake ID.
# Empty DISCORD_ALLOWLIST → deny all Discord logins (fail closed).
# Example: DISCORD_ALLOWLIST=oliver,friendname
DISCORD_ALLOWLIST=
# Same format; seeded with is_admin=1 (admin without password when logged in).
DISCORD_ADMIN_IDS=

# --- PhotoPrism (optional; leave blank to disable analog import) ---
PHOTOPRISM_BASE_URL=
PHOTOPRISM_USERNAME=
PHOTOPRISM_APP_PASSWORD=
# optional check only; upload uses session user.UID
PHOTOPRISM_USER_UID=
PHOTOPRISM_DEFAULT_ALBUM=
# PHOTOPRISM_VERIFY_TLS=true
