# Local `cargo run` — copy to repo-root `.env`.
# For Docker deploy, use deploy/app/.env.example instead.

SERVER_ADDR=127.0.0.1:8080
DATABASE_URL=sqlite://data/app.db
ANALOG_INGEST_DIR=data/ingest

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback
DISCORD_BOT_TOKEN=
DM_MESSAGE=

# dm Foto key account id for the order-status API (spot.photoprintit.com).
# 1320 = dm Germany. Leave empty to use the default.
DM_KEY_ACCOUNT_ID=1320

ADMIN_PASSWORD=
# openssl rand -base64 64
SESSION_SECRET=

# PhotoPrism (optional; session login then upload)
# PHOTOPRISM_BASE_URL=https://photos.example.com
# PHOTOPRISM_USERNAME=admin
# PHOTOPRISM_APP_PASSWORD=
# PHOTOPRISM_USER_UID=   # optional; upload uses session user.UID
# PHOTOPRISM_DEFAULT_ALBUM=
# PHOTOPRISM_VERIFY_TLS=true
