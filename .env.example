# Address the server binds to
SERVER_ADDR=127.0.0.1:8080

# SQLite database path. The file will be created automatically if missing.
DATABASE_URL=sqlite://data/app.db

# Discord OAuth application credentials (Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# Optional: bot token used by the "Send me a Discord DM" feature.
# Discord Developer Portal -> Your app -> Bot -> "Reset Token".
# The bot can only DM a user if it shares at least one guild with them.
DISCORD_BOT_TOKEN=

# Optional: message text sent by the "Send me a Discord DM" feature.
# If empty, a default greeting is used.
# IMPORTANT: values containing spaces MUST be quoted, e.g.
#   DM_MESSAGE="Hello from my photo site!"
DM_MESSAGE=

# Plain-text admin password gating the /admin routes
ADMIN_PASSWORD=

# Long random secret used to sign session cookies (at least 64 bytes).
# Generate with: openssl rand -base64 64
SESSION_SECRET=
